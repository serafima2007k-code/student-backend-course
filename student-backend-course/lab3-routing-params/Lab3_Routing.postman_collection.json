        {
          "name": "GET Search",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));\r",
                  "pm.test(\"Результат содержит 'Москва'\", () => {\r",
                  "  const data = pm.response.json();\r",
                  "  pm.expect(data.cities.length).to.be.above(0);\r",
                  "  pm.expect(data.cities[0].name).to.include('Москва');\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
