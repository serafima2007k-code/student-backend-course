                "{{base_url}}"
              ],
              "path": [
                "cities"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Москва"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET Sort",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));\r",
                  "pm.test(\"Отсортировано по убыванию population\", () => {\r",
                  "  const data = pm.response.json();\r",
                  "  const populations = data.cities.map(c => c.population);\r",
                  "  for (let i = 1; i < populations.length; i++) {\r",
                  "    pm.expect(populations[i]).to.be.at.most(populations[i - 1]);\r",
                  "  }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/cities?sort=population&order=desc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cities"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "population"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            }
          },
