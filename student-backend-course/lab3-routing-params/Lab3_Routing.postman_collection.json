      "item": [
        {
          "name": "GET All Cities",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));\r",
                  "pm.test(\"Ответ в JSON\", () => pm.response.to.be.json);\r",
                  "pm.test(\"Есть поле count\", () => {\r",
                  "  const data = pm.response.json();\r",
                  "  pm.expect(data).to.have.property('count');\r",
                  "});\r",
                  "pm.test(\"cities — массив\", () => {\r",
                  "  const data = pm.response.json();\r",
                  "  pm.expect(data.cities).to.be.an('array');\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/cities",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cities"
              ]
            }
          },
          "response": []
        },
