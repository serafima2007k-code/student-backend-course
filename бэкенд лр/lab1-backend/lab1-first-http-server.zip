  "item": [
    {
      "name": "Items",
      "item": [
        {
          "name": "GET All Items",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Проверка статуса ответа\r",
                  "pm.test(\"Статус 200 OK\", function () {\r",
                  " pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Проверка, что ответ - JSON\r",
                  "pm.test(\"Ответ в формате JSON\", function () {\r",
                  " pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "// Проверка наличия поля count\r",
                  "pm.test(\"Есть поле count\", function () {\r",
                  " const jsonData = pm.response.json();\r",
                  " pm.expect(jsonData).to.have.property('count');\r",
                  "});\r",
                  "\r",
                  "// Проверка, что items - массив\r",
                  "pm.test(\"items - это массив\", function () {\r",
                  " const jsonData = pm.response.json();\r",
                  " pm.expect(jsonData.items).to.be.an('array');\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/items",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "items"
              ]
            }
          },
          "response": []
        },
